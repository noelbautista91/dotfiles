[user]
	email = noel@noynoy.org
	name = Noel Bautista
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBg8wanF/61h6IizynEwyrXwTx3TTt5/37Cz0Ao8Nq+d

[gpg]
	format = ssh

[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign

[commit]
	gpgsign = true

[tag]
	gpgSign = true
[init]
	defaultBranch = main
[credential]
	helper = osxkeychain

# ============================================================================
# Breeze Dark Color Scheme
# See .config/colors/breeze-dark.conf for full palette reference
# ============================================================================

[color]
	ui = auto

[color "diff"]
	meta = blue bold
	frag = yellow bold
	old = red
	new = green
	commit = blue
	whitespace = red reverse

[color "status"]
	added = green
	changed = yellow
	untracked = cyan
	deleted = red
	branch = blue bold

[color "branch"]
	current = blue bold
	local = white
	remote = green
	upstream = cyan
