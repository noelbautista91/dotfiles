#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLAKE_DIR="$(dirname "$SCRIPT_DIR")"

HOST="${1:-$(hostname)}"

echo "Rebuilding $HOST using frozen flake.lock..."

if [ "$(uname)" = "Darwin" ]; then
  darwin-rebuild switch --flake "$FLAKE_DIR#$HOST"
else
  sudo nixos-rebuild switch --flake "$FLAKE_DIR#$HOST"
fi

echo ""
echo "Done."