{
  "memory": {
    "command": "nix",
    "args": ["shell", "nixpkgs#nodejs", "--command", "npx", "-y", "@modelcontextprotocol/server-memory"]
  },
  "db-mcp": {
    "type": "http",
    "url": "http://localhost:3000/mcp"
  },
  "beads": {
    "command": "nix",
    "args": ["shell", "nixpkgs#uv", "--command", "uvx", "beads-mcp"],
    "env": {
      "BEADS_WORKING_DIR": "/home/noelbautista91/Documents/Projects/memory"
    }
  },
  "sequential-thinking": {
    "command": "nix",
    "args": ["shell", "nixpkgs#nodejs", "--command", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
    "enabled": false
  },
  "playwright": {
    "type": "http",
    "url": "http://localhost:8931/mcp"
  },
  "nixos": {
    "command": "nix",
    "args": ["shell", "nixpkgs#uv", "--command", "uvx", "mcp-nixos"]
  }
}